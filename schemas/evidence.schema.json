{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "External evidence record (plan 16.2).",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "maxItems": 1000,
      "title": "Artifacts",
      "type": "array"
    },
    "build_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Build Id"
    },
    "kind": {
      "enum": [
        "eda_compile",
        "simulation",
        "formal",
        "coverage"
      ],
      "title": "Kind",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "profile": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Profile",
      "type": "string"
    },
    "result": {
      "enum": [
        "NOT_RUN",
        "BLOCKED",
        "PASS",
        "FAIL"
      ],
      "title": "Result",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "test_name": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test Name"
    },
    "tool_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Version"
    },
    "trust_class": {
      "default": "EXTERNAL_DECLARED",
      "enum": [
        "EXTERNAL_DECLARED",
        "RUNTIME_OBSERVED"
      ],
      "title": "Trust Class",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "producer",
    "profile",
    "result"
  ],
  "title": "EvidenceManifest",
  "type": "object"
}
