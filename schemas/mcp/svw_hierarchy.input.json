{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "required": [
          "instance_id",
          "instance_path"
        ]
      }
    },
    {
      "not": {
        "required": [
          "instance_id",
          "top"
        ]
      }
    },
    {
      "not": {
        "required": [
          "instance_path",
          "top"
        ]
      }
    }
  ],
  "properties": {
    "build_id": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "cursor": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "depth": {
      "maximum": 1000,
      "minimum": 0,
      "type": "integer"
    },
    "instance_id": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "instance_path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "limit": {
      "default": 100,
      "maximum": 500,
      "minimum": 1,
      "type": "integer"
    },
    "top": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    }
  },
  "required": [
    "build_id"
  ],
  "type": "object"
}
