{
  "$defs": {
    "AnalysisCoverage": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "reference_coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceCoverage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "unresolved_count": {
          "default": 0,
          "title": "Unresolved Count",
          "type": "integer"
        }
      },
      "required": [
        "completeness"
      ],
      "title": "AnalysisCoverage",
      "type": "object"
    },
    "Completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "SOURCE_CANDIDATE",
        "LSP_RESOLVED",
        "HDL_STATIC_RESOLVED",
        "RUNTIME_OBSERVED",
        "EXTERNAL_DECLARED",
        "UNRESOLVED"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Freshness": {
      "enum": [
        "CURRENT",
        "STALE",
        "HISTORICAL",
        "UNKNOWN"
      ],
      "title": "Freshness",
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "OK",
        "PARTIAL",
        "BLOCKED",
        "ERROR"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 100,
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "title": "Pagination",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "evidence_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "toolchain_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toolchain Id"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "ReferenceCoverage": {
      "additionalProperties": false,
      "description": "HDL-R01 v1: coverage of the reference index, independent of build success.\n\nA COMPLETE build can have a PARTIAL reference index. Zero observed gaps is not\nevidence of exhaustive traversal. This contract never authorizes negative reference,\nimpact, unused-symbol or safe-deletion conclusions, nor complete-rename claims.",
      "properties": {
        "absence_proof_supported": {
          "const": false,
          "default": false,
          "title": "Absence Proof Supported",
          "type": "boolean"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "contract_version": {
          "const": "1",
          "default": "1",
          "title": "Contract Version",
          "type": "string"
        },
        "depth_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Limit"
        },
        "features": {
          "additionalProperties": {
            "enum": [
              "PARTIAL",
              "UNSUPPORTED",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "title": "Features",
          "type": "object"
        },
        "observations": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceObservations"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query": {
          "anyOf": [
            {
              "enum": [
                "references",
                "impact",
                "rename_preview"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "result_truncated": {
          "default": false,
          "title": "Result Truncated",
          "type": "boolean"
        },
        "scopes": {
          "additionalProperties": {
            "enum": [
              "PARTIAL",
              "NOT_SEARCHED",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "title": "Scopes",
          "type": "object"
        },
        "searched_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Searched Scope"
        },
        "status": {
          "enum": [
            "PARTIAL",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "features",
        "scopes"
      ],
      "title": "ReferenceCoverage",
      "type": "object"
    },
    "ReferenceObservations": {
      "additionalProperties": false,
      "description": "Recorded occurrences, not an exhaustive census of omitted source references.",
      "properties": {
        "dropped_references_external": {
          "minimum": 0,
          "title": "Dropped References External",
          "type": "integer"
        },
        "dropped_references_project": {
          "minimum": 0,
          "title": "Dropped References Project",
          "type": "integer"
        },
        "dynamic_references": {
          "minimum": 0,
          "title": "Dynamic References",
          "type": "integer"
        },
        "inactive_regions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Inactive Regions",
          "type": "object"
        },
        "scope_gaps": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Scope Gaps",
          "type": "object"
        },
        "unresolved_references": {
          "minimum": 0,
          "title": "Unresolved References",
          "type": "integer"
        },
        "unsupported_nodes_external": {
          "minimum": 0,
          "title": "Unsupported Nodes External",
          "type": "integer"
        },
        "unsupported_nodes_project": {
          "minimum": 0,
          "title": "Unsupported Nodes Project",
          "type": "integer"
        }
      },
      "required": [
        "unsupported_nodes_project",
        "unsupported_nodes_external",
        "dropped_references_project",
        "dropped_references_external",
        "unresolved_references",
        "dynamic_references",
        "scope_gaps",
        "inactive_regions"
      ],
      "title": "ReferenceObservations",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "build_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Build Id"
    },
    "data": {
      "properties": {
        "backend_used": {
          "type": "string"
        },
        "degraded": {
          "type": "boolean"
        },
        "items": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "query": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "freshness": {
      "$ref": "#/$defs/Freshness",
      "default": "UNKNOWN"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "pagination": {
      "$ref": "#/$defs/Pagination"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "workspace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    }
  },
  "required": [
    "request_id",
    "outcome"
  ],
  "title": "svw_search result envelope",
  "type": "object"
}
