{
  "$defs": {
    "AnalysisCoverage": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "unresolved_count": {
          "default": 0,
          "title": "Unresolved Count",
          "type": "integer"
        }
      },
      "required": [
        "completeness"
      ],
      "title": "AnalysisCoverage",
      "type": "object"
    },
    "Completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "SOURCE_CANDIDATE",
        "LSP_RESOLVED",
        "HDL_STATIC_RESOLVED",
        "RUNTIME_OBSERVED",
        "EXTERNAL_DECLARED",
        "UNRESOLVED"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Freshness": {
      "enum": [
        "CURRENT",
        "STALE",
        "HISTORICAL",
        "UNKNOWN"
      ],
      "title": "Freshness",
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "OK",
        "PARTIAL",
        "BLOCKED",
        "ERROR"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 100,
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "title": "Pagination",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "evidence_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "toolchain_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toolchain Id"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "build_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Build Id"
    },
    "data": {
      "properties": {
        "already_running": {
          "type": "boolean"
        },
        "build_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cancel_accepted": {
          "type": "boolean"
        },
        "cancel_note": {
          "type": "string"
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "TIMED_OUT"
          ]
        },
        "owned_by_this_session": {
          "type": "boolean"
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "type": "object"
        },
        "result": {
          "type": "object"
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "freshness": {
      "$ref": "#/$defs/Freshness",
      "default": "UNKNOWN"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "pagination": {
      "$ref": "#/$defs/Pagination"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "workspace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    }
  },
  "required": [
    "request_id",
    "outcome"
  ],
  "title": "svw_build result envelope",
  "type": "object"
}
