{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expected_snapshot_id": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "profile": {
      "pattern": "^[A-Za-z0-9_.-]{1,64}$",
      "type": "string"
    },
    "reuse": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "profile"
  ],
  "type": "object"
}
