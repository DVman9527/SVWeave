# SVWeave runtime state (snapshots, candidates, DB, logs) — never commit
.svweave/
# Pinned backend installs / downloaded artifacts (reproduced by scripts/bootstrap_locked.py)
.toolchain/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.*.swp
# Host-specific root mappings
svweave.local.yaml
.claude/

# GitHub archives that bootstrap_locked.py downloads next to vendor/downloads wheels
vendor/downloads/*.tar.gz
# ... except the pinned uv release tarball, which the offline package carries (vendor/README.md)
!vendor/downloads/uv-*.tar.gz
