+class ContinuousAssignSymbol;
+class SLANG_EXPORT ExperimentalLeafSession {
+public:
+    static std::string fixture(bool b);
+    ExperimentalLeafSession();
+    uint64_t generation() const { return generation_; }
+    // Rejects all inputs except the two exact fixture byte strings, before parsing/binding.
+    // At most two commits. No external native AST handles or concurrent callers supported.
+    bool update(std::string_view bytes);
+    std::string snapshot(uint64_t generation);
+    Compilation::ExperimentalWork changedWork() const;
+    Compilation::ExperimentalWork controlWork() const;
+    bool controlRetained() const;
+    bool unaffectedWorkRetained() const;
+private:
+    SourceManager sources;
+    std::vector<std::shared_ptr<syntax::SyntaxTree>> trees;
+    Compilation compilation;
+    std::vector<const ContinuousAssignSymbol*> changed;
+    const ContinuousAssignSymbol* control = nullptr;
+    const Expression* originalControl = nullptr;
+    uint64_t generation_ = 0;
+    bool currentB = false;
+    bool poisoned = false;
+    uint64_t acceptedDiagnosticEmissions = 0;
+    std::map<const Scope*, Compilation::ExperimentalWork> baselineWork;
+};
+}
