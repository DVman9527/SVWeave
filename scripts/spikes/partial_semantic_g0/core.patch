+std::string ExperimentalLeafSession::fixture(bool b, bool references) {
+    if (references) {
+        std::string text =
+            "module changed(output bit y, k); bit a, b; assign y = a & a; assign k = a; endmodule\n"
+            "module control(output bit y); bit a, b; assign y = a & a; endmodule\n"
+            "module top(output bit x, x2, k, k2, z); changed u0(x,k); changed u2(x2,k2); control u1(z); endmodule\n";
+        if (b) text.replace(text.find("a & a"), 5, "b & b");
+        return text;
+    }
+    std::string text =
+        "module changed(output bit y); assign y = 1'b0; endmodule\n"
+        "module control(output bit y); assign y = 1'b1; endmodule\n"
+        "module top(output bit x, x2, z); changed u0(x); changed u2(x2); control u1(z); endmodule\n";
+    if (b) text[text.find("1'b0") + 3] = '1';
+    return text;
+}
+ExperimentalLeafSession::ExperimentalLeafSession(bool references) : references(references) {
+    trees.push_back(syntax::SyntaxTree::fromText(fixture(false, references), sources, "fixture.sv"));
+    compilation.addSyntaxTree(trees.back());
+    if (!compilation.getAllDiagnostics().empty())
+        throw std::runtime_error("baseline diagnostics: admission denied");
+    auto visitor = makeVisitor([&](auto&, const ContinuousAssignSymbol& symbol) {
+        auto& body = symbol.getParentScope()->asSymbol().as<InstanceBodySymbol>();
+        const auto& assignment = symbol.getAssignment().as<AssignmentExpression>();
+        auto target = assignment.left().getSymbolReference();
+        if (body.getDefinition().name == "changed" && target && target->name == "y") {
+            if (std::find(changed.begin(), changed.end(), &symbol) == changed.end())
+                changed.push_back(&symbol);
+        }
+        else unchangedAssignments.emplace_back(&symbol, &assignment);
+        if (body.getDefinition().name == "control") control = &symbol;
+        (void)symbol.getAssignment();
+    });
+    compilation.getRoot().visit(visitor);
+    if (changed.size() != 2 || !control) throw std::runtime_error("fixture hierarchy mismatch");
+    for (auto owner : changed) {
+        const auto& assignment = owner->getAssignment().as<AssignmentExpression>();
+        auto leftSyntax = assignment.left().getSymbolReference()->getSyntax();
+        const syntax::SyntaxNode* readSyntax = nullptr;
+        for (auto& member : owner->getParentScope()->members())
+            if (member.name == "a") readSyntax = member.getSyntax();
+        uint64_t reads = 0, writes = 0;
+        for (auto event : compilation.experimentalReferenceOwners.at(owner)) {
+            if (event.write) { ++writes; if (event.node != leftSyntax) throw std::runtime_error("unexpected LHS contribution"); }
+            else { ++reads; if (!references || event.node != readSyntax) throw std::runtime_error("unexpected initial RHS contribution"); }
+        }
+        if (writes != 1 || reads != (references ? 2u : 0u))
+            throw std::runtime_error("fixture reference ownership invariant failed");
+    }
+    originalControl = &control->getAssignment();
+    acceptedDiagnosticEmissions = compilation.experimentalDiagnosticEmissions;
+}
+bool ExperimentalLeafSession::update(std::string_view bytes) {
+    if (poisoned) throw std::runtime_error("poisoned session; discard");
+    if (bytes != fixture(false, references) && bytes != fixture(true, references)) return false;
+    bool nextB = bytes == fixture(true, references);
+    if (nextB == currentB) return true; // Exact-byte no-op: no parsing, binding, generation advance.
+    if (generation_ >= 2) return false;
+    baselineWork = compilation.experimentalWork;
+    poisoned = true; // Any unexpected exception after admission permanently disables queries.
+    const auto diagnosticEmissions = compilation.experimentalDiagnosticEmissions;
+    // Unique physical buffers, stable logical filename supplied via fromText line directive.
+    // Inputs have identical lengths and differ only in the admitted RHS tokens.
+    auto tree = syntax::SyntaxTree::fromText(bytes, sources, "fixture.sv");
+    const syntax::BinaryExpressionSyntax* replacement = nullptr;
+    auto syntaxVisitor = syntax::makeSyntaxVisitor(
+        [&](auto&, const syntax::BinaryExpressionSyntax& expr) {
+            if (!replacement) replacement = &expr;
+        });
+    tree->root().visit(syntaxVisitor);
+    auto actualSource = sources.getSourceText(tree->root().getFirstToken().location().buffer());
+    if (!actualSource.empty() && actualSource.back() == '\0') actualSource.remove_suffix(1);
+    if (actualSource != bytes) throw std::runtime_error("active source buffer mismatch");
+    if (!replacement || !tree->diagnostics().empty())
+        throw std::runtime_error("admitted fixture parse invariant failed");
+    std::vector<const Expression*> freshAssignments;
+    std::vector<std::pair<const void*, Compilation::ExperimentalReferences>> stagedReferences;
+    trees.push_back(std::move(tree));
+    for (auto symbol : changed) {
+        const auto& old = symbol->getAssignment().as<AssignmentExpression>();
+        auto sourceSlice = [&](SourceRange range) {
+            if (range.start().buffer() != range.end().buffer())
+                throw std::runtime_error("cross-buffer source range");
+            return sources.getSourceText(range.start().buffer()).substr(
+                range.start().offset(), range.end().offset() - range.start().offset());
+        };
+        auto newRight = replacement->right->sourceRange();
+        auto newLeft = replacement->left->sourceRange();
+        auto oldLeft = old.left().sourceRange;
+        if (sourceSlice(newRight) != (references ? (nextB ? "b & b" : "a & a") : (nextB ? "1'b1" : "1'b0")) ||
+            sourceSlice(newLeft) != "y" || sourceSlice(oldLeft) != "y" ||
+            sources.getLineNumber(newLeft.start()) != sources.getLineNumber(oldLeft.start()) ||
+            sources.getColumnNumber(newLeft.start()) != sources.getColumnNumber(oldLeft.start()) ||
+            sources.getFileName(newLeft.start()) != "fixture.sv" ||
+            sources.getFileName(newRight.start()) != "fixture.sv")
+            throw std::runtime_error("generation source provenance invariant failed");
+        ASTContext context(*symbol->getParentScope(), LookupLocation::after(*symbol),
+                           ASTFlags::NonProcedural);
+        Compilation::ExperimentalReferences candidateReferences;
+        struct DeferredGuard {
+            Compilation& comp;
+            ~DeferredGuard() { comp.experimentalReferenceCapture = nullptr; comp.experimentalDeferReferences = false; }
+        } deferred{compilation};
+        if (compilation.experimentalReferenceCapture || compilation.experimentalDeferReferences)
+            throw std::runtime_error("nested deferred reference capture");
+        compilation.experimentalReferenceCapture = &candidateReferences;
+        compilation.experimentalDeferReferences = true;
+        const auto& rhs = Expression::bindRValue(*old.left().type, *replacement->right,
+                                                replacement->sourceRange(), context);
+        compilation.experimentalReferenceCapture = nullptr;
+        compilation.experimentalDeferReferences = false;
+        const syntax::SyntaxNode* expectedRead = nullptr;
+        for (auto& member : symbol->getParentScope()->members())
+            if (member.name == (nextB ? "b" : "a")) expectedRead = member.getSyntax();
+        if (candidateReferences.size() != (references ? 2u : 0u))
+            throw std::runtime_error("unexpected RHS reference event multiplicity");
+        for (auto event : candidateReferences)
+            if (event.write || !references || event.node != expectedRead)
+                throw std::runtime_error("RHS reference target invariant failed");
+        // Immutable LHS contribution stays once; only previous RHS reads are withdrawn.
+        for (auto event : compilation.experimentalReferenceOwners.at(symbol))
+            if (event.write) candidateReferences.push_back(event);
+        stagedReferences.emplace_back(symbol, std::move(candidateReferences));
+        if (compilation.experimentalDiagnosticEmissions != diagnosticEmissions)
+            throw std::runtime_error("new diagnostic emitted; discard poisoned session");
+        if (rhs.bad()) throw std::runtime_error("admitted fixture binding invariant failed; discard session");
+        auto fresh = compilation.emplace<AssignmentExpression>(old.op, old.isNonBlocking(),
+            *old.type, const_cast<Expression&>(old.left()), const_cast<Expression&>(rhs),
+            old.timingControl, replacement->sourceRange());
+        fresh->syntax = replacement;
+        // LHS driver/reference contribution is unchanged and is NOT registered a second time.
+        // Old assignment and RHS remain immutable in the arena; all tree owners stay alive.
+        freshAssignments.push_back(fresh);
+    }
+    compilation.experimentalReplaceReferences(std::move(stagedReferences));
+    for (size_t i = 0; i < changed.size(); ++i) changed[i]->assign = freshAssignments[i];
+    ++generation_;
+    currentB = nextB;
+    poisoned = false;
+    return true;
+}
+std::string ExperimentalLeafSession::snapshot(uint64_t generation) {
+    if (poisoned) throw std::runtime_error("poisoned session; discard");
+    if (generation != generation_) throw std::runtime_error("stale generation handle");
+    if (compilation.experimentalDiagnosticEmissions != acceptedDiagnosticEmissions ||
+        !compilation.getAllDiagnostics().empty()) {
+        poisoned = true;
+        throw std::runtime_error("unexpected diagnostics");
+    }
+    JsonWriter writer;
+    ASTSerializer serializer(compilation, writer);
+    serializer.setIncludeAddresses(false);
+    serializer.setIncludeSourceInfo(true);
+    serializer.setDetailedTypeInfo(true);
+    writer.startObject();
+    writer.writeProperty("root");
+    serializer.serialize(compilation.getRoot());
+    writer.writeProperty("concrete_instances");
+    writer.startArray();
+    auto instanceVisitor = makeVisitor([&](auto& visitor, const InstanceSymbol& instance) {
+        writer.startObject();
+        writer.writeProperty("path"); writer.writeValue(instance.getHierarchicalPath());
+        writer.writeProperty("body"); serializer.serialize(instance.body);
+        writer.writeProperty("resolved_targets"); writer.startArray();
+        auto targets = makeVisitor([&](auto&, const NamedValueExpression& expr) {
+            writer.writeValue(expr.symbol.getHierarchicalPath());
+        });
+        instance.body.visit(targets);
+        writer.endArray();
+        writer.writeProperty("usage_semantics");
+        writer.writeValue("per-instance-AST-occurrences; native-flags-shared-declaration-aggregate");
+        std::map<const ValueSymbol*, std::pair<uint64_t, uint64_t>> occurrenceCounts;
+        for (auto& member : instance.body.members()) {
+            if (auto assignment = member.as_if<ContinuousAssignSymbol>()) {
+                auto& expr = assignment->getAssignment().as<AssignmentExpression>();
+                auto reads = makeVisitor([&](auto&, const NamedValueExpression& ref) {
+                    ++occurrenceCounts[&ref.symbol].first;
+                });
+                auto writes = makeVisitor([&](auto&, const NamedValueExpression& ref) {
+                    ++occurrenceCounts[&ref.symbol].second;
+                });
+                expr.right().visit(reads); expr.left().visit(writes);
+            }
+        }
+        writer.writeProperty("reference_usage"); writer.startArray();
+        for (auto& member : instance.body.members()) {
+            if (auto value = member.as_if<VariableSymbol>(); value && value->getSyntax()) {
+                auto count = occurrenceCounts[value];
+                auto flags = compilation.isReferenced(*value->getSyntax());
+                writer.startObject();
+                writer.writeProperty("target"); writer.writeValue(value->getHierarchicalPath());
+                writer.writeProperty("read_occurrences"); writer.writeValue(count.first);
+                writer.writeProperty("write_occurrences"); writer.writeValue(count.second);
+                writer.writeProperty("native_read"); writer.writeValue(flags.first);
+                writer.writeProperty("native_write"); writer.writeValue(flags.second);
+                writer.endObject();
+            }
+        }
+        writer.endArray();
+        writer.endObject();
+        visitor.visitDefault(instance);
+    });
+    compilation.getRoot().visit(instanceVisitor);
+    writer.endArray(); writer.endObject();
+    if (compilation.experimentalDiagnosticEmissions != acceptedDiagnosticEmissions) {
+        poisoned = true;
+        throw std::runtime_error("diagnostic during snapshot; discard poisoned session");
+    }
+    return std::string(writer.view());
+}
+std::string ExperimentalLeafSession::referenceLedger(uint64_t generation) {
+    if (poisoned || generation != generation_) throw std::runtime_error("invalid ledger handle");
+    JsonWriter writer;
+    writer.startArray();
+    auto visitor = makeVisitor([&](auto& visitor, const InstanceSymbol& instance) {
+        for (auto& member : instance.body.members()) {
+            if (auto value = member.as_if<VariableSymbol>(); value && value->getSyntax()) {
+                auto it = compilation.experimentalReferenceCounts.find(value->getSyntax());
+                auto count = it == compilation.experimentalReferenceCounts.end() ? std::pair<uint64_t,uint64_t>{0,0} : it->second;
+                writer.startObject();
+                writer.writeProperty("target"); writer.writeValue(value->getHierarchicalPath());
+                writer.writeProperty("read_events"); writer.writeValue(count.first);
+                writer.writeProperty("write_events"); writer.writeValue(count.second);
+                writer.endObject();
+            }
+        }
+        visitor.visitDefault(instance);
+    });
+    compilation.getRoot().visit(visitor);
+    writer.endArray();
+    if (compilation.experimentalDiagnosticEmissions != acceptedDiagnosticEmissions) {
+        poisoned = true;
+        throw std::runtime_error("diagnostic during ledger readout");
+    }
+    return std::string(writer.view());
+}
+Compilation::ExperimentalWork ExperimentalLeafSession::changedWork() const {
+    Compilation::ExperimentalWork total;
+    for (auto symbol : changed) {
+        auto w = compilation.experimentalWork.at(symbol->getParentScope());
+        total.expressions += w.expressions;
+        total.lookups += w.lookups;
+        total.assignments += w.assignments;
+        total.conversions += w.conversions;
+    }
+    return total;
+}
+Compilation::ExperimentalWork ExperimentalLeafSession::controlWork() const {
+    return compilation.experimentalWork.at(control->getParentScope());
+}
+bool ExperimentalLeafSession::unaffectedWorkRetained() const {
+    auto current = compilation.experimentalWork;
+    auto baseline = baselineWork;
+    for (auto symbol : changed) {
+        current.erase(symbol->getParentScope());
+        baseline.erase(symbol->getParentScope());
+    }
+    return current == baseline;
+}
+bool ExperimentalLeafSession::unaffectedAssignmentsRetained() const {
+    for (auto [symbol, expression] : unchangedAssignments)
+        if (&symbol->getAssignment() != expression) return false;
+    return true;
+}
+bool ExperimentalLeafSession::referenceUsageVerified() const {
+    if (!references || poisoned) return false;
+    for (auto owner : changed) {
+        bool foundA = false, foundB = false;
+        for (auto& symbol : owner->getParentScope()->members()) {
+            if (auto value = symbol.as_if<VariableSymbol>(); value && value->getSyntax()) {
+                auto flags = compilation.isReferenced(*value->getSyntax());
+                auto it = compilation.experimentalReferenceCounts.find(value->getSyntax());
+                auto reads = it == compilation.experimentalReferenceCounts.end() ? 0 : it->second.first;
+                if (value->name == "a") { foundA = true; if (!flags.first || !reads) return false; }
+                if (value->name == "b") { foundB = true; if (flags.first != currentB || (reads != 0) != currentB) return false; }
+            }
+        }
+        if (!foundA || !foundB) return false;
+    }
+    return unaffectedAssignmentsRetained();
+}
+bool ExperimentalLeafSession::controlRetained() const {
+    return &control->getAssignment() == originalControl;
+}
