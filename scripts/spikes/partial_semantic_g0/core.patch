+std::string ExperimentalLeafSession::fixture(bool b) {
+    std::string text =
+        "module changed(output bit y); assign y = 1'b0; endmodule\n"
+        "module control(output bit y); assign y = 1'b1; endmodule\n"
+        "module top(output bit x, x2, z); changed u0(x); changed u2(x2); control u1(z); endmodule\n";
+    if (b) text[text.find("1'b0") + 3] = '1';
+    return text;
+}
+ExperimentalLeafSession::ExperimentalLeafSession() {
+    trees.push_back(syntax::SyntaxTree::fromText(fixture(false), sources, "fixture.sv"));
+    compilation.addSyntaxTree(trees.back());
+    if (!compilation.getAllDiagnostics().empty())
+        throw std::runtime_error("baseline diagnostics: admission denied");
+    auto visitor = makeVisitor([&](auto&, const ContinuousAssignSymbol& symbol) {
+        auto& body = symbol.getParentScope()->asSymbol().as<InstanceBodySymbol>();
+        if (body.getDefinition().name == "changed") {
+            if (std::find(changed.begin(), changed.end(), &symbol) == changed.end())
+                changed.push_back(&symbol);
+        }
+        if (body.getDefinition().name == "control") control = &symbol;
+        (void)symbol.getAssignment();
+    });
+    compilation.getRoot().visit(visitor);
+    if (changed.size() != 2 || !control) throw std::runtime_error("fixture hierarchy mismatch");
+    originalControl = &control->getAssignment();
+    acceptedDiagnosticEmissions = compilation.experimentalDiagnosticEmissions;
+}
+bool ExperimentalLeafSession::update(std::string_view bytes) {
+    if (poisoned) throw std::runtime_error("poisoned session; discard");
+    if (generation_ >= 2 || (bytes != fixture(false) && bytes != fixture(true))) return false;
+    bool nextB = bytes == fixture(true);
+    if (nextB == currentB) return false;
+    baselineWork = compilation.experimentalWork;
+    poisoned = true; // Any unexpected exception after admission permanently disables queries.
+    const auto diagnosticEmissions = compilation.experimentalDiagnosticEmissions;
+    // Unique physical buffers, stable logical filename supplied via fromText line directive.
+    // Both inputs have identical lengths and differ only in the RHS literal bit.
+    auto tree = syntax::SyntaxTree::fromText(bytes, sources, "fixture.sv");
+    const syntax::BinaryExpressionSyntax* replacement = nullptr;
+    auto syntaxVisitor = syntax::makeSyntaxVisitor(
+        [&](auto&, const syntax::BinaryExpressionSyntax& expr) {
+            if (!replacement) replacement = &expr;
+        });
+    tree->root().visit(syntaxVisitor);
+    auto actualSource = sources.getSourceText(tree->root().getFirstToken().location().buffer());
+    if (!actualSource.empty() && actualSource.back() == '\0') actualSource.remove_suffix(1);
+    if (actualSource != bytes) throw std::runtime_error("active source buffer mismatch");
+    if (!replacement || !tree->diagnostics().empty())
+        throw std::runtime_error("admitted fixture parse invariant failed");
+    std::vector<const Expression*> freshAssignments;
+    trees.push_back(std::move(tree));
+    for (auto symbol : changed) {
+        const auto& old = symbol->getAssignment().as<AssignmentExpression>();
+        auto sourceSlice = [&](SourceRange range) {
+            if (range.start().buffer() != range.end().buffer())
+                throw std::runtime_error("cross-buffer source range");
+            return sources.getSourceText(range.start().buffer()).substr(
+                range.start().offset(), range.end().offset() - range.start().offset());
+        };
+        auto newRight = replacement->right->sourceRange();
+        auto newLeft = replacement->left->sourceRange();
+        auto oldLeft = old.left().sourceRange;
+        if (sourceSlice(newRight) != (nextB ? "1'b1" : "1'b0") ||
+            sourceSlice(newLeft) != "y" || sourceSlice(oldLeft) != "y" ||
+            sources.getLineNumber(newLeft.start()) != sources.getLineNumber(oldLeft.start()) ||
+            sources.getColumnNumber(newLeft.start()) != sources.getColumnNumber(oldLeft.start()) ||
+            sources.getFileName(newLeft.start()) != "fixture.sv" ||
+            sources.getFileName(newRight.start()) != "fixture.sv")
+            throw std::runtime_error("generation source provenance invariant failed");
+        ASTContext context(*symbol->getParentScope(), LookupLocation::after(*symbol),
+                           ASTFlags::NonProcedural);
+        const auto& rhs = Expression::bindRValue(*old.left().type, *replacement->right,
+                                                replacement->sourceRange(), context);
+        if (compilation.experimentalDiagnosticEmissions != diagnosticEmissions)
+            throw std::runtime_error("new diagnostic emitted; discard poisoned session");
+        if (rhs.bad()) throw std::runtime_error("admitted fixture binding invariant failed; discard session");
+        auto fresh = compilation.emplace<AssignmentExpression>(old.op, old.isNonBlocking(),
+            *old.type, const_cast<Expression&>(old.left()), const_cast<Expression&>(rhs),
+            old.timingControl, replacement->sourceRange());
+        fresh->syntax = replacement;
+        // LHS driver/reference contribution is unchanged and is NOT registered a second time.
+        // Old assignment and RHS remain immutable in the arena; all tree owners stay alive.
+        freshAssignments.push_back(fresh);
+    }
+    for (size_t i = 0; i < changed.size(); ++i) changed[i]->assign = freshAssignments[i];
+    ++generation_;
+    currentB = nextB;
+    poisoned = false;
+    return true;
+}
+std::string ExperimentalLeafSession::snapshot(uint64_t generation) {
+    if (poisoned) throw std::runtime_error("poisoned session; discard");
+    if (generation != generation_) throw std::runtime_error("stale generation handle");
+    if (compilation.experimentalDiagnosticEmissions != acceptedDiagnosticEmissions ||
+        !compilation.getAllDiagnostics().empty()) throw std::runtime_error("unexpected diagnostics");
+    JsonWriter writer;
+    ASTSerializer serializer(compilation, writer);
+    serializer.setIncludeAddresses(false);
+    serializer.setIncludeSourceInfo(true);
+    serializer.setDetailedTypeInfo(true);
+    writer.startObject();
+    writer.writeProperty("root");
+    serializer.serialize(compilation.getRoot());
+    writer.writeProperty("concrete_instances");
+    writer.startArray();
+    auto instanceVisitor = makeVisitor([&](auto& visitor, const InstanceSymbol& instance) {
+        writer.startObject();
+        writer.writeProperty("path"); writer.writeValue(instance.getHierarchicalPath());
+        writer.writeProperty("body"); serializer.serialize(instance.body);
+        writer.writeProperty("resolved_targets"); writer.startArray();
+        auto targets = makeVisitor([&](auto&, const NamedValueExpression& expr) {
+            writer.writeValue(expr.symbol.getHierarchicalPath());
+        });
+        instance.body.visit(targets);
+        writer.endArray(); writer.endObject();
+        visitor.visitDefault(instance);
+    });
+    compilation.getRoot().visit(instanceVisitor);
+    writer.endArray(); writer.endObject();
+    if (compilation.experimentalDiagnosticEmissions != acceptedDiagnosticEmissions) {
+        poisoned = true;
+        throw std::runtime_error("diagnostic during snapshot; discard poisoned session");
+    }
+    return std::string(writer.view());
+}
+Compilation::ExperimentalWork ExperimentalLeafSession::changedWork() const {
+    Compilation::ExperimentalWork total;
+    for (auto symbol : changed) {
+        auto w = compilation.experimentalWork.at(symbol->getParentScope());
+        total.expressions += w.expressions;
+        total.lookups += w.lookups;
+        total.assignments += w.assignments;
+        total.conversions += w.conversions;
+    }
+    return total;
+}
+Compilation::ExperimentalWork ExperimentalLeafSession::controlWork() const {
+    return compilation.experimentalWork.at(control->getParentScope());
+}
+bool ExperimentalLeafSession::unaffectedWorkRetained() const {
+    auto current = compilation.experimentalWork;
+    auto baseline = baselineWork;
+    for (auto symbol : changed) {
+        current.erase(symbol->getParentScope());
+        baseline.erase(symbol->getParentScope());
+    }
+    return current == baseline;
+}
+bool ExperimentalLeafSession::controlRetained() const {
+    return &control->getAssignment() == originalControl;
+}
+}
