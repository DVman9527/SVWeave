+void Compilation::experimentalReplaceReferences(
+    std::vector<std::pair<const void*, ExperimentalReferences>> replacements) {
+    // Validate and stage every owner and shared-key aggregate BEFORE the commit boundary.
+    auto counts = experimentalReferenceCounts;
+    auto owners = experimentalReferenceOwners;
+    auto status = referenceStatusMap;
+    std::map<const syntax::SyntaxNode*, bool> touched;
+    std::map<const void*, bool> seen;
+    for (auto& [owner, replacement] : replacements) {
+        if (!seen.emplace(owner, true).second)
+            throw std::runtime_error("duplicate reference owner replacement");
+        for (auto event : owners.at(owner)) {
+            touched[event.node] = true;
+            auto& count = counts.at(event.node);
+            auto& value = event.write ? count.second : count.first;
+            if (!value) throw std::runtime_error("reference contribution underflow");
+            --value;
+        }
+        for (auto event : replacement) {
+            touched[event.node] = true;
+            auto& count = counts[event.node];
+            auto& value = event.write ? count.second : count.first;
+            if (value == std::numeric_limits<uint64_t>::max())
+                throw std::runtime_error("reference contribution overflow");
+            ++value;
+        }
+        owners.at(owner) = std::move(replacement);
+    }
+    // No native rebinding/global clear; only touched flags derive from complete event totals.
+    for (const auto& [node, ignored] : touched) {
+        const auto& count = counts.at(node);
+        status[node] = {count.first != 0, count.second != 0};
+    }
+    static_assert(noexcept(experimentalReferenceOwners.swap(owners)));
+    static_assert(noexcept(experimentalReferenceCounts.swap(counts)));
+    static_assert(noexcept(referenceStatusMap.swap(status)));
+    experimentalReferenceOwners.swap(owners);
+    experimentalReferenceCounts.swap(counts);
+    referenceStatusMap.swap(status);
 }
 
