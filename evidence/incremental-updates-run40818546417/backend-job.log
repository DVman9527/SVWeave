2026-10-29T04:35:25.6294823Z Official Ubuntu apparmor-profiles 4.0.1really4.0.1-0ubuntu0.24.04.9; sha256=90b02aa006eea7702cd4e851343e469e41365dda42145a3cb035de1d6c773b8c
2026-10-29T04:35:25.6375000Z Official profile sha256=11d39094f044f0cda0febb3ad517b830301da6b2ce929664af09ee9e4dd264f9
2026-10-29T04:35:25.6375911Z # This profile allows almost everything and only exists to allow
2026-10-29T04:35:25.6376674Z # bwrap to work on a system with user namespace restrictions
2026-10-29T04:35:25.6377090Z # being enforced.
2026-10-29T04:35:25.6377428Z # bwrap is allowed access to user namespaces and capabilities
2026-10-29T04:35:25.6377909Z # within the user namespace, but its children do not have
2026-10-29T04:35:25.6378381Z # capabilities, blocking bwrap from being able to be used to
2026-10-29T04:35:25.6378846Z # arbitrarily by-pass the user namespace restrictions.
2026-10-29T04:35:25.6379233Z #
2026-10-29T04:35:25.6379555Z # Note: the bwrap child is stacked against the bwrap profile due to
2026-10-29T04:35:25.6380310Z # bwraps use of no-new-privs
2026-10-29T04:35:25.6380536Z 
2026-10-29T04:35:25.6380752Z # disabled by default as it can break some use cases on a system that
2026-10-29T04:35:25.6381303Z # doesn't have or has disable user namespace restrictions for unconfined
2026-10-29T04:35:25.6381757Z # use aa-enforce to enable it
2026-10-29T04:35:25.6381941Z 
2026-10-29T04:35:25.6382053Z abi <abi/4.0>,
2026-10-29T04:35:25.6382203Z 
2026-10-29T04:35:25.6382313Z include <tunables/global>
2026-10-29T04:35:25.6382486Z 
2026-10-29T04:35:25.6382670Z profile bwrap /usr/bin/bwrap flags=(attach_disconnected) {
2026-10-29T04:35:25.6383062Z   allow capability,
2026-10-29T04:35:25.6383327Z   # not allow all, to allow for pix stack
2026-10-29T04:35:25.6383761Z   # sadly we have to allow  m every where to allow children to work under
2026-10-29T04:35:25.6384187Z   # stacking.
2026-10-29T04:35:25.6384613Z   allow file rwlkm /{**,},
2026-10-29T04:35:25.6384878Z   allow network,
2026-10-29T04:35:25.6385104Z   allow unix,
2026-10-29T04:35:25.6385326Z   allow ptrace,
