2026-10-29T04:35:44.7506982Z Official profile sha256=11d39094f044f0cda0febb3ad517b830301da6b2ce929664af09ee9e4dd264f9
2026-10-29T04:35:44.7508263Z # This profile allows almost everything and only exists to allow
2026-10-29T04:35:44.7509367Z # bwrap to work on a system with user namespace restrictions
2026-10-29T04:35:44.7509965Z # being enforced.
2026-10-29T04:35:44.7510453Z # bwrap is allowed access to user namespaces and capabilities
2026-10-29T04:35:44.7511162Z # within the user namespace, but its children do not have
2026-10-29T04:35:44.7511598Z # capabilities, blocking bwrap from being able to be used to
2026-10-29T04:35:44.7512030Z # arbitrarily by-pass the user namespace restrictions.
2026-10-29T04:35:44.7512358Z #
2026-10-29T04:35:44.7512651Z # Note: the bwrap child is stacked against the bwrap profile due to
2026-10-29T04:35:44.7513024Z # bwraps use of no-new-privs
2026-10-29T04:35:44.7513377Z 
2026-10-29T04:35:44.7513564Z # disabled by default as it can break some use cases on a system that
2026-10-29T04:35:44.7514025Z # doesn't have or has disable user namespace restrictions for unconfined
2026-10-29T04:35:44.7514409Z # use aa-enforce to enable it
2026-10-29T04:35:44.7514569Z 
2026-10-29T04:35:44.7514655Z abi <abi/4.0>,
2026-10-29T04:35:44.7514775Z 
2026-10-29T04:35:44.7514873Z include <tunables/global>
2026-10-29T04:35:44.7515026Z 
2026-10-29T04:35:44.7515187Z profile bwrap /usr/bin/bwrap flags=(attach_disconnected) {
2026-10-29T04:35:44.7515516Z   allow capability,
2026-10-29T04:35:44.7515759Z   # not allow all, to allow for pix stack
2026-10-29T04:35:44.7516145Z   # sadly we have to allow  m every where to allow children to work under
2026-10-29T04:35:44.7516510Z   # stacking.
2026-10-29T04:35:44.7516719Z   allow file rwlkm /{**,},
2026-10-29T04:35:44.7516956Z   allow network,
2026-10-29T04:35:44.7517157Z   allow unix,
2026-10-29T04:35:44.7517351Z   allow ptrace,
2026-10-29T04:35:44.7517562Z   allow signal,
2026-10-29T04:35:44.7518055Z   allow mqueue,
2026-10-29T04:35:44.7518261Z   allow io_uring,
2026-10-29T04:35:44.7518460Z   allow userns,
2026-10-29T04:35:44.7518653Z   allow mount,
2026-10-29T04:35:44.7518850Z   allow umount,
2026-10-29T04:35:44.7519045Z   allow pivot_root,
2026-10-29T04:35:44.7519252Z   allow dbus,
2026-10-29T04:35:44.7519504Z   allow px /** -> bwrap//&unpriv_bwrap,
2026-10-29T04:35:44.7519701Z 
2026-10-29T04:35:44.7519901Z   # the local include should not be used without understanding the userns
2026-10-29T04:35:44.7520270Z   # restriction.
2026-10-29T04:35:44.7520593Z   # Site-specific additions and overrides. See local/README for details.
2026-10-29T04:35:44.7521027Z   include if exists <local/bwrap-userns-restrict>
2026-10-29T04:35:44.7521335Z }
2026-10-29T04:35:44.7521431Z 
2026-10-29T04:35:44.7521571Z profile unpriv_bwrap flags=(attach_disconnected) {
2026-10-29T04:35:44.7521894Z   # not allow all, to allow for pix stack
2026-10-29T04:35:44.7522180Z   allow file rwlkm /{**,},
2026-10-29T04:35:44.7522415Z   allow network,
2026-10-29T04:35:44.7522609Z   allow unix,
2026-10-29T04:35:44.7522800Z   allow ptrace,
2026-10-29T04:35:44.7522994Z   allow signal,
2026-10-29T04:35:44.7523187Z   allow mqueue,
2026-10-29T04:35:44.7523375Z   allow io_uring,
2026-10-29T04:35:44.7523569Z   allow userns,
2026-10-29T04:35:44.7523753Z   allow mount,
2026-10-29T04:35:44.7523950Z   allow umount,
2026-10-29T04:35:44.7524145Z   allow pivot_root,
2026-10-29T04:35:44.7524348Z   allow dbus,
2026-10-29T04:35:44.7524464Z 
2026-10-29T04:35:44.7524564Z   allow pix /** -> &unpriv_bwrap,
2026-10-29T04:35:44.7524735Z 
2026-10-29T04:35:44.7524831Z   audit deny capability,
2026-10-29T04:35:44.7524975Z 
2026-10-29T04:35:44.7525169Z   # the local include should not be used without understanding the userns
2026-10-29T04:35:44.7525538Z   # restriction.
2026-10-29T04:35:44.7525850Z   # Site-specific additions and overrides. See local/README for details.
2026-10-29T04:35:44.7526252Z   include if exists <local/unpriv_bwrap>
2026-10-29T04:35:44.7526515Z }
