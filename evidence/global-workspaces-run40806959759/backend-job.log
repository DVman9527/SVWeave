2026-10-29T02:33:33.9550111Z Official profile sha256=11d39094f044f0cda0febb3ad517b830301da6b2ce929664af09ee9e4dd264f9
2026-10-29T02:33:33.9551058Z # This profile allows almost everything and only exists to allow
2026-10-29T02:33:33.9552024Z # bwrap to work on a system with user namespace restrictions
2026-10-29T02:33:33.9552431Z # being enforced.
2026-10-29T02:33:33.9552758Z # bwrap is allowed access to user namespaces and capabilities
2026-10-29T02:33:33.9553219Z # within the user namespace, but its children do not have
2026-10-29T02:33:33.9553663Z # capabilities, blocking bwrap from being able to be used to
2026-10-29T02:33:33.9554104Z # arbitrarily by-pass the user namespace restrictions.
2026-10-29T02:33:33.9554473Z #
2026-10-29T02:33:33.9554770Z # Note: the bwrap child is stacked against the bwrap profile due to
2026-10-29T02:33:33.9555177Z # bwraps use of no-new-privs
2026-10-29T02:33:33.9555350Z 
2026-10-29T02:33:33.9555553Z # disabled by default as it can break some use cases on a system that
2026-10-29T02:33:33.9556069Z # doesn't have or has disable user namespace restrictions for unconfined
2026-10-29T02:33:33.9556504Z # use aa-enforce to enable it
2026-10-29T02:33:33.9556677Z 
2026-10-29T02:33:33.9556771Z abi <abi/4.0>,
2026-10-29T02:33:33.9556909Z 
2026-10-29T02:33:33.9557011Z include <tunables/global>
2026-10-29T02:33:33.9557179Z 
2026-10-29T02:33:33.9557349Z profile bwrap /usr/bin/bwrap flags=(attach_disconnected) {
2026-10-29T02:33:33.9557720Z   allow capability,
2026-10-29T02:33:33.9557973Z   # not allow all, to allow for pix stack
2026-10-29T02:33:33.9558390Z   # sadly we have to allow  m every where to allow children to work under
2026-10-29T02:33:33.9558785Z   # stacking.
2026-10-29T02:33:33.9559481Z   allow file rwlkm /{**,},
2026-10-29T02:33:33.9559744Z   allow network,
