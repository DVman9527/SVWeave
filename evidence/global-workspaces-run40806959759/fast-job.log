2026-10-29T02:33:13.4112646Z Official Ubuntu apparmor-profiles 4.0.1really4.0.1-0ubuntu0.24.04.9; sha256=90b02aa006eea7702cd4e851343e469e41365dda42145a3cb035de1d6c773b8c
2026-10-29T02:33:13.4170106Z Official profile sha256=11d39094f044f0cda0febb3ad517b830301da6b2ce929664af09ee9e4dd264f9
2026-10-29T02:33:13.4170604Z # This profile allows almost everything and only exists to allow
2026-10-29T02:33:13.4171277Z # bwrap to work on a system with user namespace restrictions
2026-10-29T02:33:13.4171465Z # being enforced.
2026-10-29T02:33:13.4171627Z # bwrap is allowed access to user namespaces and capabilities
2026-10-29T02:33:13.4171837Z # within the user namespace, but its children do not have
2026-10-29T02:33:13.4172048Z # capabilities, blocking bwrap from being able to be used to
2026-10-29T02:33:13.4172260Z # arbitrarily by-pass the user namespace restrictions.
2026-10-29T02:33:13.4172436Z #
2026-10-29T02:33:13.4172591Z # Note: the bwrap child is stacked against the bwrap profile due to
2026-10-29T02:33:13.4172789Z # bwraps use of no-new-privs
2026-10-29T02:33:13.4172987Z 
2026-10-29T02:33:13.4173085Z # disabled by default as it can break some use cases on a system that
2026-10-29T02:33:13.4173329Z # doesn't have or has disable user namespace restrictions for unconfined
2026-10-29T02:33:13.4173529Z # use aa-enforce to enable it
2026-10-29T02:33:13.4173619Z 
2026-10-29T02:33:13.4173667Z abi <abi/4.0>,
2026-10-29T02:33:13.4173737Z 
2026-10-29T02:33:13.4173799Z include <tunables/global>
2026-10-29T02:33:13.4173879Z 
2026-10-29T02:33:13.4173966Z profile bwrap /usr/bin/bwrap flags=(attach_disconnected) {
2026-10-29T02:33:13.4174145Z   allow capability,
2026-10-29T02:33:13.4174276Z   # not allow all, to allow for pix stack
2026-10-29T02:33:13.4174550Z   # sadly we have to allow  m every where to allow children to work under
2026-10-29T02:33:13.4174739Z   # stacking.
2026-10-29T02:33:13.4174856Z   allow file rwlkm /{**,},
2026-10-29T02:33:13.4174984Z   allow network,
2026-10-29T02:33:13.4175096Z   allow unix,
2026-10-29T02:33:13.4175214Z   allow ptrace,
2026-10-29T02:33:13.4175333Z   allow signal,
2026-10-29T02:33:13.4175439Z   allow mqueue,
2026-10-29T02:33:13.4175547Z   allow io_uring,
2026-10-29T02:33:13.4175665Z   allow userns,
2026-10-29T02:33:13.4175773Z   allow mount,
2026-10-29T02:33:13.4175880Z   allow umount,
2026-10-29T02:33:13.4175989Z   allow pivot_root,
2026-10-29T02:33:13.4176104Z   allow dbus,
2026-10-29T02:33:13.4176260Z   allow px /** -> bwrap//&unpriv_bwrap,
2026-10-29T02:33:13.4176359Z 
2026-10-29T02:33:13.4176464Z   # the local include should not be used without understanding the userns
2026-10-29T02:33:13.4176657Z   # restriction.
2026-10-29T02:33:13.4176833Z   # Site-specific additions and overrides. See local/README for details.
2026-10-29T02:33:13.4177059Z   include if exists <local/bwrap-userns-restrict>
2026-10-29T02:33:13.4177220Z }
2026-10-29T02:33:13.4177280Z 
2026-10-29T02:33:13.4177352Z profile unpriv_bwrap flags=(attach_disconnected) {
2026-10-29T02:33:13.4177536Z   # not allow all, to allow for pix stack
2026-10-29T02:33:13.4177685Z   allow file rwlkm /{**,},
2026-10-29T02:33:13.4177815Z   allow network,
2026-10-29T02:33:13.4177926Z   allow unix,
2026-10-29T02:33:13.4178035Z   allow ptrace,
2026-10-29T02:33:13.4178148Z   allow signal,
2026-10-29T02:33:13.4178254Z   allow mqueue,
2026-10-29T02:33:13.4178364Z   allow io_uring,
2026-10-29T02:33:13.4178474Z   allow userns,
2026-10-29T02:33:13.4178585Z   allow mount,
2026-10-29T02:33:13.4178699Z   allow umount,
2026-10-29T02:33:13.4178809Z   allow pivot_root,
2026-10-29T02:33:13.4178923Z   allow dbus,
2026-10-29T02:33:13.4178988Z 
2026-10-29T02:33:13.4179048Z   allow pix /** -> &unpriv_bwrap,
2026-10-29T02:33:13.4179140Z 
2026-10-29T02:33:13.4179194Z   audit deny capability,
2026-10-29T02:33:13.4179274Z 
2026-10-29T02:33:13.4179377Z   # the local include should not be used without understanding the userns
2026-10-29T02:33:13.4179568Z   # restriction.
2026-10-29T02:33:13.4179736Z   # Site-specific additions and overrides. See local/README for details.
2026-10-29T02:33:13.4179942Z   include if exists <local/unpriv_bwrap>
2026-10-29T02:33:13.4180086Z }
